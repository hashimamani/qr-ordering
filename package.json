{
  "name": "qr-ordering",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant QR table ordering platform",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "seed": "ts-node src/db/seed.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "loadtest": "ts-node scripts/loadtest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.632.0",
    "@aws-sdk/client-dynamodb": "^3.632.0",
    "@aws-sdk/client-secrets-manager": "^3.632.0",
    "@aws-sdk/client-ses": "^3.632.0",
    "@aws-sdk/client-sqs": "^3.632.0",
    "@aws-sdk/lib-dynamodb": "^3.632.0",
    "africastalking": "^0.8.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "serverless-http": "^3.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "autocannon": "^7.15.0",
    "node-pg-migrate": "^7.6.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
