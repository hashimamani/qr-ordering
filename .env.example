DATABASE_URL=postgres://qr_ordering:qr_ordering@localhost:5434/qr_ordering
PORT=3010
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3010
PUBLIC_ORDERING_BASE_URL=http://localhost:3010

# Auth
JWT_SECRET=change-me-in-every-real-environment
PLATFORM_ADMIN_KEY=change-me-too

# Notifications -- dry-run logs instead of calling a real provider. Set to
# "false" and provide real credentials below to actually send.
NOTIFICATIONS_DRY_RUN=true
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
SES_FROM_ADDRESS=

# Leave unset locally: when set, notifications are enqueued onto real SQS
# instead of the in-process queue.
SQS_NOTIFICATIONS_QUEUE_URL=
