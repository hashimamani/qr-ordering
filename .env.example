DATABASE_URL=postgres://qr_ordering:qr_ordering@localhost:5434/qr_ordering
PORT=3010
LOG_LEVEL=info
# The frontend's origin (React/Vite, its own separate app under frontend/)
# -- not this API's own PORT above. Used for tracking links (SMS/email)
# and generated QR codes, both of which need to point at a browsable page.
PUBLIC_BASE_URL=http://localhost:5173
PUBLIC_ORDERING_BASE_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-every-real-environment
# Signs the platform_admin (super-admin/onboarding) JWT -- deliberately a
# different secret from JWT_SECRET, so a leaked staff secret can't forge
# a platform-admin token.
PLATFORM_ADMIN_JWT_SECRET=change-me-in-every-real-environment-too

# Notifications -- dry-run logs instead of calling a real provider. Set to
# "false" and provide real credentials below to actually send.
NOTIFICATIONS_DRY_RUN=true
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
SES_FROM_ADDRESS=

# Leave unset locally: when set, notifications are enqueued onto real SQS
# instead of the in-process queue.
SQS_NOTIFICATIONS_QUEUE_URL=

# Web push (waiter notifications) -- generate a pair with
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
# Leave unset to just no-op push sends (WebSocket still works either way).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
